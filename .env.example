# Cadena de conexion de Supabase.
# Supabase -> Project Settings -> Database -> Connection string -> Transaction pooler
# Use el puerto 6543 (pooler), no el 5432: en serverless el directo se queda sin conexiones.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Opcionales
PORT=3000
BANCA_SESION_HORAS=12
