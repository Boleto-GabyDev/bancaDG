# ============================================================
#  Conexion a Supabase
# ============================================================
#  Use el TRANSACTION POOLER, no la conexion directa:
#    Supabase -> Project Settings -> Database -> Connection string
#                -> Transaction pooler
#
#  El host directo (db.<proyecto>.supabase.co) solo resuelve por IPv6
#  y Vercel no tiene salida IPv6: en produccion fallaria.
#
#  En el pooler el usuario lleva el codigo del proyecto pegado:
#    postgres.<proyecto>        (no solo "postgres")
#
DATABASE_URL=postgresql://postgres.xxxxxxxx@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# La clave va aparte para que no importe si trae simbolos (@ # ? / %)
# que dentro de una URL habria que codificar.
DATABASE_PASSWORD=

# Opcionales
PORT=3000
BANCA_SESION_HORAS=12
